# Copie ce fichier en .env et remplis les valeurs. Ne jamais commit .env.

# --- Base de données (PostgreSQL intégré, sans Docker : fichiers dans data/postgres) ---
DATABASE_URL=postgresql://jobradar:change-moi@127.0.0.1:5434/jobradar

# --- France Travail (francetravail.io) ---
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=

# --- Adzuna (étape 11) ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- IA locale gratuite (Ollama, https://ollama.com) — facultatif, valeurs par défaut ci-dessous ---
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=gemma4:e4b
# Modèle plus gros pour la lettre de motivation seulement (~2 à 3 min par lettre, 8 Go à télécharger : ollama pull gemma4:12b)
# OLLAMA_LETTER_MODEL=gemma4:12b

# --- Email (étape 10) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Gmail : SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=ton adresse,
# SMTP_PASSWORD=mot de passe d'application (myaccount.google.com/apppasswords)
SMTP_FROM=
NOTIFY_EMAIL_TO=

# --- Ton compte pour te connecter à l'appli ---
SEED_USER_EMAIL=
SEED_USER_PASSWORD=

# --- Application ---
APP_URL=http://localhost:5173
SESSION_SECRET=

CRON_INTERVAL_MINUTES=30
# false = pas de collecte automatique (bouton Actualiser seulement)
SCHEDULER_ENABLED=true

# JobScraper (dépôt Python externe, collectes désactivées par défaut)
JOBSCRAPER_ENABLED=false
JOBSCRAPER_PATH=tools/jobscraper
# JOBSCRAPER_PYTHON=C:/chemin/vers/python.exe
JOBSCRAPER_TIMEOUT_MS=120000

# Suivi des candidatures : lit ta boîte mail (même compte que SMTP_USER / SMTP_PASSWORD) en LECTURE SEULE
# pour reconnaître accusés de réception, entretiens, propositions et refus. Gmail : IMAP déduit de SMTP_HOST.
MAIL_TRACKING_ENABLED=false
# IMAP_HOST=imap.gmail.com
MIN_JOB_SCORE_FOR_NOTIFICATION=70

# --- Notifications navigateur (générées par pnpm setup:push) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# --- Temps de trajet ---
# Île-de-France : transports depuis la gare d'arrivée (compte gratuit sur prim.iledefrance-mobilites.fr).
# Ailleurs : voiture depuis le domicile avec OSRM (serveur public gratuit, sans clé). OSRM_URL : ton propre serveur OSRM.
PRIM_API_KEY=
# OSRM_URL=http://localhost:5000
